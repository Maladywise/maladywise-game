[
  {"id":"x1","room":"chronic","patient":"June, 82","test":"Potassium","value":"6.7","units":"mmol/L","flag":"high","action":"Urgent","why":"6.5 or more is severe hyperkalaemia: urgent hospital assessment even if she seems well (typical range about 3.5 to 5.2).","source":"https://ukkidney.org/sites/renal.org/files/RENAL%20ASSOCIATION%20HYPERKALAEMIA%20GUIDELINE%20-%20JULY%202022%20V2_0.pdf"},
  {"id":"x2","room":"drugs","patient":"Dimitri, 71","test":"Potassium (on ramipril, feels well)","value":"5.7","units":"mmol/L","flag":"high","action":"Recall","why":"Mild (5.5 to 5.9) and well: repeat within days, look at medicines and diet, and consider the ACE inhibitor dose. Not an ambulance.","source":"https://ukkidney.org/sites/renal.org/files/RENAL%20ASSOCIATION%20HYPERKALAEMIA%20GUIDELINE%20-%20JULY%202022%20V2_0.pdf"},
  {"id":"x3","room":"chronic","patient":"Aroha, 49","test":"Potassium","value":"4.3","units":"mmol/L","flag":"","action":"File","why":"Within the typical range (about 3.5 to 5.2). File it.","source":"https://ukkidney.org/sites/renal.org/files/RENAL%20ASSOCIATION%20HYPERKALAEMIA%20GUIDELINE%20-%20JULY%202022%20V2_0.pdf"},
  {"id":"x4","room":"resus","patient":"Wal, 78","test":"Sodium (carer says he's confused)","value":"118","units":"mmol/L","flag":"low","action":"Urgent","why":"Below 120 with confusion is severe, symptomatic hyponatraemia: same-day hospital care, where it can be corrected safely and slowly (typical range about 135 to 145).","source":"https://www.statpearls.com/ArticleLibrary/viewarticle/23274"},
  {"id":"x5","room":"womens","patient":"Priya, 34","test":"Ferritin","value":"8","units":"µg/L","flag":"low","action":"Recall","why":"Iron deficiency (typical range for women roughly 30 to 300). She needs iron and a conversation about why: heavy periods are the usual suspect.","source":"https://safetyandquality.gov.au/standards/clinical-care-standards/heavy-menstrual-bleeding-clinical-care-standard/information-clinicians-heavy-menstrual-bleeding-clinical-care-standard"},
  {"id":"x6","room":"chronic","patient":"Ray, 66","test":"Hb 104 g/L, ferritin 9 µg/L","value":"Iron-deficiency anaemia","units":"","flag":"low","action":"Recall","why":"New iron-deficiency anaemia in a man: GI blood loss is the most common cause, so gastroscopy and colonoscopy are generally first-line. Book him in to discuss and refer.","source":"https://www.lifeblood.com.au/health-professionals/clinical-practice/clinical-indications/iron-deficiency-anaemia/determining-the-underlying-causes"},
  {"id":"x7","room":"chronic","patient":"Graham, 67","test":"HbA1c (no known diabetes)","value":"6.9","units":"%","flag":"high","action":"Recall","why":"6.5% or more means diabetes is likely. He needs a proper conversation, not a filed result.","source":"https://www.racgp.org.au/getattachment/7a2da393-b76f-405a-a2fe-0c9c0c0d5ac8/20635-DBHB-clinical-summary-web-alt-V9.pdf.aspx"},
  {"id":"x8","room":"chronic","patient":"Lupe, 58","test":"HbA1c (type 2 diabetes)","value":"6.6","units":"%","flag":"","action":"File","why":"At target: the general HbA1c target is 7% (53 mmol/mol) or less. File it, and say well done at the next review.","source":"https://www.racgp.org.au/getattachment/7a2da393-b76f-405a-a2fe-0c9c0c0d5ac8/20635-DBHB-clinical-summary-web-alt-V9.pdf.aspx"},
  {"id":"x9","room":"chronic","patient":"Hannah, 29","test":"TSH <0.01 mIU/L, free T4 high","value":"Overactive thyroid pattern","units":"","flag":"high","action":"Recall","why":"Low TSH with high free T4 is hyperthyroidism. She needs review, assessment of the cause and treatment.","source":"https://pathologytestsexplained.org.au/learning/test-index/ft4"},
  {"id":"x10","room":"chronic","patient":"Priya, 34","test":"TSH","value":"2.1","units":"mIU/L","flag":"","action":"File","why":"Normal (typical range about 0.4 to 4). Her mum's thyroid is not her thyroid.","source":"https://pathologytestsexplained.org.au/learning/test-index/ft4"},
  {"id":"x11","room":"chronic","patient":"Lachlan, 31","test":"TSH 38 mIU/L, free T4 low","value":"Underactive thyroid pattern","units":"","flag":"high","action":"Recall","why":"High TSH with low free T4 is hypothyroidism. Book him in to start treatment, with Lachlan in the conversation.","source":"https://pathologytestsexplained.org.au/learning/test-index/ft4"},
  {"id":"x12","room":"drugs","patient":"Mohammed, 74","test":"INR (warfarin, target 2 to 3)","value":"2.6","units":"","flag":"","action":"File","why":"In range. File it, keep the dose.","source":"https://clinicaldata.nzblood.co.nz/resourcefolder/documents/Warfarin%20reversal%20MJA%202013.pdf"},
  {"id":"x13","room":"drugs","patient":"Beryl, 80","test":"INR (warfarin, no bleeding)","value":"6.2","units":"","flag":"high","action":"Urgent","why":"INR 4.5 to 10: she needs to be told today to withhold warfarin, with a cause review and a repeat INR. Vitamin K only if bleeding risk is high.","source":"https://clinicaldata.nzblood.co.nz/resourcefolder/documents/Warfarin%20reversal%20MJA%202013.pdf"},
  {"id":"x14","room":"drugs","patient":"Stan, 77","test":"INR (warfarin, no bleeding)","value":"11.5","units":"","flag":"high","action":"Urgent","why":"Above 10: stop warfarin and give vitamin K, with an INR in 12 to 24 hours. Today, not tomorrow.","source":"https://clinicaldata.nzblood.co.nz/resourcefolder/documents/Warfarin%20reversal%20MJA%202013.pdf"},
  {"id":"x15","room":"drugs","patient":"Fiona, 55","test":"Neutrophils (on methotrexate, mouth ulcers)","value":"0.4","units":"×10⁹/L","flag":"low","action":"Urgent","why":"Severe neutropenia on methotrexate with mouth ulcers: contact her today, hold the methotrexate and assess urgently (typical range about 2 to 7.5).","source":"https://arthritisaustralia.com.au/wordpress/wp-content/uploads/2019/08/Methotrexate_2019_000.pdf"},
  {"id":"x16","room":"resus","patient":"Kevin, 63","test":"Corrected calcium","value":"3.6","units":"mmol/L","flag":"high","action":"Urgent","why":"About 3.5 mmol/L (14 mg/dL) or more is severe hypercalcaemia and usually needs inpatient treatment (typical range about 2.1 to 2.6).","source":"https://www.statpearls.com/sp/md/88/41122/"},
  {"id":"x17","room":"chronic","patient":"Lupe, 58","test":"Urine albumin-creatinine ratio (diabetes)","value":"40","units":"mg/mmol","flag":"high","action":"Recall","why":"Albuminuria (3.5 or more counts as raised in women). Confirm on repeat, then optimise kidney protection.","source":"https://www.nps.org.au/news/ckd-integrating-kidney-health-into-patient-care"},
  {"id":"x18","room":"chronic","patient":"Tran, 52","test":"eGFR","value":"85","units":"mL/min/1.73m²","flag":"","action":"File","why":"Above 60 with no other markers of damage isn't CKD. File it.","source":"https://www.nps.org.au/news/ckd-integrating-kidney-health-into-patient-care"},
  {"id":"x19","room":"womens","patient":"Chloe, 20","test":"Chlamydia NAAT (urine)","value":"Detected","units":"","flag":"high","action":"Recall","why":"Treat (doxycycline is first-line), contact-trace back 6 months, no sex for 7 days, and retest at 3 months.","source":"https://www.health.wa.gov.au/wa-sti-and-bbv-guidelines/infections/chlamydia"},
  {"id":"x20","room":"womens","patient":"Grace, 41","test":"Cervical screening","value":"HPV not detected","units":"","flag":"","action":"File","why":"Back to routine screening in 5 years.","source":"https://www.cancer.org.au/assets/pdf/cervical-screening-quick-reference-guide"},
  {"id":"x21","room":"womens","patient":"Leilani, 33","test":"Cervical screening","value":"HPV 16 detected","units":"","flag":"high","action":"Recall","why":"HPV 16/18 means referral for colposcopy. She needs to hear it from you, not a portal.","source":"https://www.cancer.org.au/assets/pdf/cervical-screening-quick-reference-guide"},
  {"id":"x22","room":"womens","patient":"Ngaio, 45","test":"Cervical screening (self-collected)","value":"HPV (not 16/18) detected","units":"","flag":"high","action":"Recall","why":"After a self-collected sample, HPV (not 16/18) means she needs to come back for a clinician-collected sample for cytology.","source":"https://www.cancer.org.au/assets/pdf/cervical-screening-quick-reference-guide"},
  {"id":"x23","room":"chronic","patient":"Bruce, 61","test":"Bowel screening kit (iFOBT)","value":"Positive","units":"","flag":"high","action":"Recall","why":"A positive result isn't a cancer diagnosis, but it means a colonoscopy referral and the program will chase it if nothing's reported.","source":"https://www.health.gov.au/sites/default/files/2025-10/national-bowel-cancer-screening-program-participant-screening-pathway.pdf"},
  {"id":"x24","room":"chronic","patient":"Margaret, 70","test":"Vitamin D","value":"62","units":"nmol/L","flag":"","action":"File","why":"At least 50 nmol/L is the recommended level. File it, no supplement upgrade needed.","source":"https://healthybonesaustralia.org.au/?p=418"},
  {"id":"x25","room":"outreach","patient":"Fatima, 38","test":"Vitamin D (recently arrived, covers skin)","value":"22","units":"nmol/L","flag":"low","action":"Recall","why":"Below 30 nmol/L needs attention, usually with supplements.","source":"https://healthybonesaustralia.org.au/?p=418"},
  {"id":"x26","room":"outreach","patient":"Abdi, 41","test":"Interferon gamma release assay (IGRA)","value":"Positive","units":"","flag":"high","action":"Recall","why":"Part of post-arrival refugee screening. Positive means TB infection needs assessment (active TB excluded, then latent TB managed), so it's a referral, not a filing job.","source":"https://www.rch.org.au/uploadedFiles/Main/Content/immigranthealth/Quick%20guide%20to%20screening%20tests%20in%20adults.pdf"},
  {"id":"x27","room":"outreach","patient":"Ali, 27","test":"Strongyloides serology","value":"Positive","units":"","flag":"high","action":"Recall","why":"Strongyloides screening is recommended for all refugee arrivals because a positive result needs treatment.","source":"https://www.rch.org.au/uploadedFiles/Main/Content/immigranthealth/Quick%20guide%20to%20screening%20tests%20in%20adults.pdf"},
  {"id":"x28","room":"chronic","patient":"Peter, 62","test":"PSA","value":"12","units":"µg/L","flag":"high","action":"Recall","why":"Clearly raised. The 2026 Australian guidelines suggest repeating an elevated PSA within 1 to 3 months, then referral and MRI if it stays up. Either way, he needs a conversation.","source":"https://www.lumusimaging.com.au/resources/updated-prostate-cancer-guidelines-psa-testing-referral-and-the-role-of-prostate-mri"},
  {"id":"x29","room":"treatment","patient":"Tom, 19","test":"Lumbar spine X-ray","value":"Normal","units":"","flag":"","action":"File","why":"Normal, and wasn't needed. File it, and remember imaging in back pain without red flags rarely helps.","source":"https://www.safetyandquality.gov.au/sites/default/files/2022-08/low_back_pain_clinical_care_standard.pdf"},
  {"id":"x30","room":"mind","patient":"Colin, 59","test":"Lithium level (new tremor and unsteadiness)","value":"2.1","units":"mmol/L","flag":"high","action":"Urgent","why":"Lithium toxicity with neurological symptoms: same-day emergency assessment (therapeutic is about 1 mmol/L or below).","source":"https://emergencycarebc.ca/clinical_resource/clinical-summary/lithium-toxicity/"}
]
